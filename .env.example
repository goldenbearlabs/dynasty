# Copy to .env for `docker compose up` in production.
DOMAIN=dynasty.example.com
DB_PASSWORD=change-me
ADMIN_TOKEN=change-me
# Optional: send a feed that refuses this server's address through a relay.
# FETCH_VIA=statsapi.mlb.com=https://your-relay.workers.dev
# Optional: the clock the nightly syncs run on (default America/New_York).
# TZ=America/New_York

# Docker Compose supplies its internal Redis URL automatically.
# Host development: REDIS_URL=redis://localhost:6379/0 (unset disables caching).
# Memory and connections, for a small server (defaults shown).
# GOMEMLIMIT=256MiB        # about a quarter of the server's memory
# DB_POOL=8                # Postgres connections the app may hold
# CACHE_REVISION_AGE=1s    # how long the app trusts its last look at the cache generation; 0 asks Postgres every request
